export COMPOSE_PROJECT_NAME=queuelet-e01 QUEUELET_API_PORT=18220 QUEUELET_HOOK_PORT=18221 QUEUELET_PG_PORT=15453 QUEUELET_IMAGE_TAG=e01
export QUEUELET_URL=http://localhost:18220 QUEUELET_HOOK_URL=http://localhost:18221
export NOTES=/tmp/explore-it-experiment-01/books/explore-it/exploration/experiments/01-map-it/notes.md
export PGPASSWORD=explorer
A=$QUEUELET_URL; H=$QUEUELET_HOOK_URL
db(){ psql -h localhost -p 15453 -U explorer -d queuelet -At -F'|' -c "$1"; }
# p "label" 'command' [lines] : run command, append timestamped #obs entry with trimmed output and exit status
p(){ local label=$1 cmd=$2 n=${3:-25} out rc ts; ts=$(date -u +%FT%TZ); out=$(eval "$cmd" 2>&1); rc=$?
  { printf '\n### %s #obs %s\n```\n$ %s\n' "$ts" "$label" "$cmd"; printf '%s\n' "$out" | head -n "$n"; [ "$(printf '%s\n' "$out" | wc -l)" -gt "$n" ] && echo "…(trimmed)"; printf '[exit %s]\n```\n' "$rc"; } >> "$NOTES"
  printf '%s\n' "$out" | head -n "$n"; echo "[exit $rc]"; }
note(){ printf '\n### %s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$NOTES"; }
c(){ local k=$1; shift; curl -s -w ' [HTTP %{http_code}]' -H "Authorization: Bearer $k" -H 'Content-Type: application/json' "$@"; }
enq(){ curl -s -H "Authorization: Bearer ${3:-acme-key}" -H 'Content-Type: application/json' -X POST $A/v1/queues/$1/jobs -d "$2" | jq -r .id; }
