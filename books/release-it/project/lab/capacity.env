# Written by make calibrate on 2026-10-22 at release-it/lesson-01.
# Offered rate (req/s, steady mix) one instance sustains with >= 99.5 % success and p99 <= 100 ms.
GATEWAY_CAPACITY=350
NODE_CAPACITY=300
# min(3 gateways, 2 nodes): the rate the fleet as a whole sustains.
FLEET_CAPACITY=600
# Lesson 07 needs the gateways to be the fleet's bottleneck. Its run sets GATEWAY_CPUS=0.15
# (one gateway saturated at about 215 req/s, so three: 645) and NODE_CPUS=0.75 (two nodes
# well above that), and scales the gateways' in-flight limit to match (12: ~55 ms of work).
L07_GATEWAY_CPUS=0.15
L07_NODE_CPUS=0.75
L07_GATEWAY_CAPACITY=215
L07_GATEWAY_SHED_LIMIT=12
